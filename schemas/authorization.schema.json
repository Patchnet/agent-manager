{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Patchnet/agent-manager/schemas/authorization.schema.json",
  "title": "agent-manager immutable conditional authorization grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "runId", "level", "reviewedBase", "reviewedHead",
    "evidenceDigest", "manifestDigest", "riskCeiling", "reviewerPolicy",
    "expiresAt", "permittedMutations", "providerMode", "agentManagerVersion",
    "reviewDecisionDigest", "policyBinding",
    "operatorProvenance", "manifest", "grantDigest"
  ],
  "properties": {
    "schema": { "const": "agent-manager.authorization-grant.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "level": { "enum": ["through-pr", "all"] },
    "reviewedBase": { "type": "string", "minLength": 1 },
    "reviewedHead": { "type": "string", "minLength": 1 },
    "evidenceDigest": { "$ref": "#/$defs/digest" },
    "manifestDigest": { "$ref": "#/$defs/digest" },
    "riskCeiling": { "$ref": "#/$defs/risk" },
    "reviewerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "allowedReviewerKinds", "requiredReviewerIdentityDigest", "authorIdentityDigests"],
      "properties": {
        "type": { "const": "independent-manager" },
        "allowedReviewerKinds": { "type": "array", "const": ["manager"] },
        "requiredReviewerIdentityDigest": { "$ref": "#/$defs/digest" },
        "authorIdentityDigests": {
          "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "expiresAt": { "type": "string", "format": "date-time" },
    "permittedMutations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["commit", "push", "pull-request", "merge", "version", "tag"] }
    },
    "providerMode": { "type": "string", "minLength": 1, "maxLength": 80 },
    "agentManagerVersion": { "type": "string", "minLength": 1 },
    "reviewDecisionDigest": {
      "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
    },
    "policyBinding": {
      "oneOf": [{ "$ref": "#/$defs/policyBinding" }, { "type": "null" }]
    },
    "operatorProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "grantedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "grantedAt": { "type": "string", "format": "date-time" }
      }
    },
    "manifest": { "$ref": "#/$defs/manifest" },
    "grantDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "risk": { "enum": ["low", "moderate", "high", "critical"] },
    "policyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "path", "digest"],
      "properties": {
        "schema": { "const": "agent-manager.automation-policy.v1" },
        "path": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "automationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "enabled", "repository", "approval", "risk", "provider", "shipment", "revocation"],
      "properties": {
        "schema": { "const": "agent-manager.automation-policy.v1" },
        "enabled": { "type": "boolean" },
        "repository": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "base_ref"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "base_ref": { "type": "string", "minLength": 1 }
          }
        },
        "approval": {
          "type": "object", "additionalProperties": false,
          "required": ["level", "operator", "approved_at", "expires_at"],
          "properties": {
            "level": { "enum": ["through-pr", "all"] },
            "operator": { "type": "string", "minLength": 1 },
            "approved_at": { "type": "string", "format": "date-time" },
            "expires_at": { "type": "string", "format": "date-time" }
          }
        },
        "risk": {
          "type": "object", "additionalProperties": false,
          "required": ["observed", "ceiling", "classes", "exceptions"],
          "properties": {
            "observed": { "$ref": "#/$defs/risk" },
            "ceiling": { "$ref": "#/$defs/risk" },
            "classes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "exceptions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "provider": {
          "type": "object", "additionalProperties": false,
          "required": ["mode"], "properties": { "mode": { "type": "string", "minLength": 1 } }
        },
        "shipment": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "target": { "type": ["string", "null"] },
            "repo": { "type": ["string", "null"] },
            "worktree": { "type": ["string", "null"] },
            "branch": { "type": ["string", "null"] },
            "base": { "type": ["string", "null"] },
            "remote": { "type": ["string", "null"] },
            "pr": { "type": ["string", "null"] },
            "commit_message": { "type": ["string", "null"] },
            "version": { "type": ["string", "null"] },
            "summary": { "type": ["string", "null"] },
            "poll_sec": { "type": "number", "minimum": 1, "maximum": 300 },
            "timeout_sec": { "type": "number", "minimum": 1, "maximum": 86400 },
            "check_grace_sec": { "type": "number", "minimum": 0, "maximum": 900 },
            "retry_attempts": { "type": "number", "minimum": 1, "maximum": 10 },
            "retry_base_ms": { "type": "number", "minimum": 100, "maximum": 60000 }
          }
        },
        "revocation": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["revoked_at", "revoked_by", "reason"],
              "properties": {
                "revoked_at": { "type": "string", "format": "date-time" },
                "revoked_by": { "type": "string", "minLength": 1 },
                "reason": { "type": ["string", "null"] }
              }
            }
          ]
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "runId", "grantDigest", "executionDigest", "approvalLevel",
        "permittedMutations", "reviewedBase", "reviewedHead", "evidenceDigest",
        "agentManagerVersion", "issuedAt", "receiptDigest"
      ],
      "properties": {
        "schema": { "const": "agent-manager.authorization-receipt.v1" },
        "runId": { "type": "string", "minLength": 1 },
        "grantDigest": { "$ref": "#/$defs/digest" },
        "executionDigest": { "$ref": "#/$defs/digest" },
        "approvalLevel": { "enum": ["through-pr", "all"] },
        "permittedMutations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "reviewedBase": { "type": "string", "minLength": 1 },
        "reviewedHead": { "type": "string", "minLength": 1 },
        "evidenceDigest": { "$ref": "#/$defs/digest" },
        "agentManagerVersion": { "type": "string", "minLength": 1 },
        "issuedAt": { "type": "string", "format": "date-time" },
        "receiptDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "runId", "grantDigest", "revokedAt", "revokedBy", "reason", "revocationDigest"],
      "properties": {
        "schema": { "const": "agent-manager.authorization-revocation.v1" },
        "runId": { "type": "string", "minLength": 1 },
        "grantDigest": { "$ref": "#/$defs/digest" },
        "revokedAt": { "type": "string", "format": "date-time" },
        "revokedBy": { "type": "string", "minLength": 1 },
        "reason": { "type": ["string", "null"] },
        "revocationDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level", "flow", "repo", "worktree", "branch", "base", "remote", "pr",
        "target", "commitMessage", "version", "summary", "pollSec", "timeoutSec",
        "checkGraceSec", "retryAttempts", "retryBaseMs", "providerMode", "risk",
        "permittedMutations"
      ],
      "properties": {
        "level": { "enum": ["through-pr", "all"] },
        "flow": { "enum": ["simple", "formal"] },
        "repo": { "type": "string" },
        "worktree": { "type": "string" },
        "branch": { "type": "string", "minLength": 1 },
        "base": { "type": "string", "minLength": 1 },
        "remote": { "type": "string", "minLength": 1 },
        "pr": { "type": ["string", "null"] },
        "target": { "type": ["string", "null"] },
        "commitMessage": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "summary": { "type": ["string", "null"] },
        "pollSec": { "type": "number", "minimum": 1, "maximum": 300 },
        "timeoutSec": { "type": "number", "minimum": 1, "maximum": 86400 },
        "checkGraceSec": { "type": "number", "minimum": 0, "maximum": 900 },
        "retryAttempts": { "type": "number", "minimum": 1, "maximum": 10 },
        "retryBaseMs": { "type": "number", "minimum": 100, "maximum": 60000 },
        "providerMode": { "type": "string", "minLength": 1 },
        "risk": { "$ref": "#/$defs/risk" },
        "permittedMutations": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
