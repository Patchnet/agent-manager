{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Patchnet/agent-manager/schemas/workflow.schema.json",
  "title": "agent-manager workflow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "lanes"
  ],
  "properties": {
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "repo_shorthand": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "harness_default": {
      "enum": [
        "claude",
        "codex",
        "cursor",
        "fake"
      ]
    },
    "harness_defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claude": {
          "$ref": "#/$defs/harnessOptions"
        },
        "codex": {
          "$ref": "#/$defs/harnessOptions"
        },
        "cursor": {
          "$ref": "#/$defs/harnessOptions"
        },
        "fake": {
          "$ref": "#/$defs/harnessOptions"
        }
      }
    },
    "model_default": {
      "type": "string",
      "minLength": 1
    },
    "integrate": {
      "type": "boolean"
    },
    "claim_mode": {
      "enum": [
        "auto",
        "off",
        "required"
      ]
    },
    "max_concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "remote": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "base_ref": {
      "type": "string",
      "minLength": 1
    },
    "env_allowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z_][A-Z0-9_]*$"
      }
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "delivery": {
      "$ref": "#/$defs/delivery"
    },
    "scope_overrides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scopeOverride"
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/lane"
      }
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "One line shared by every lane prompt."
    },
    "target_dev_flow": {
      "enum": [
        "simple",
        "formal"
      ]
    }
  },
  "$defs": {
    "harnessOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "effort": {
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "profile": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "single",
            "train",
            "review-only"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deliveryTarget"
          }
        }
      }
    },
    "deliveryTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lane"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
        },
        "lane": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "string",
          "minLength": 1
        },
        "pr": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope"
      ],
      "anyOf": [
        {
          "required": [
            "prompt"
          ]
        },
        {
          "required": [
            "prompt_file"
          ]
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
        },
        "harness": {
          "enum": [
            "claude",
            "codex",
            "cursor",
            "fake"
          ]
        },
        "harness_options": {
          "$ref": "#/$defs/harnessOptions"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "permission_mode": {
          "enum": [
            "acceptEdits",
            "auto",
            "dontAsk",
            "readOnly",
            "read-only",
            "read_only",
            "workspace-write"
          ]
        },
        "allowed_tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "setup": {
          "$ref": "#/$defs/verificationSetup"
        },
        "kind": {
          "enum": [
            "implementation",
            "review"
          ]
        },
        "scope": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "expected_outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allow_no_changes": {
          "type": "boolean"
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          }
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "prompt_file": {
          "type": "string",
          "minLength": 1
        },
        "fake": {
          "type": "object"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_commit": {
          "type": "boolean",
          "description": "Permit worker commits. Claude implementation lanes must then use permission_mode auto, or dontAsk with an allowed_tools rule for git; acceptEdits and workspace-write prompt before shell commands and are rejected at load."
        },
        "allow_pr": {
          "type": "boolean",
          "description": "Permit worker pull requests. Claude implementation lanes must then use permission_mode auto, or dontAsk with an allowed_tools rule for gh; acceptEdits and workspace-write prompt before shell commands and are rejected at load."
        },
        "dangerously_skip_permissions": {
          "type": "boolean"
        },
        "permission_mode": {
          "enum": [
            "acceptEdits",
            "auto",
            "dontAsk",
            "readOnly",
            "read-only",
            "read_only",
            "workspace-write"
          ]
        },
        "stall_grace_sec": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "max_runtime_sec": {
          "type": "number",
          "minimum": 5,
          "maximum": 604800
        },
        "stall_timeout_sec": {
          "type": "number",
          "minimum": 5,
          "maximum": 86400
        },
        "poll_interval_ms": {
          "type": "number",
          "minimum": 100,
          "maximum": 60000
        }
      }
    },
    "scopeOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "lanes",
        "owner",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "lanes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          }
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "access": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "write",
              "read-only"
            ]
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands"
      ],
      "properties": {
        "timeout_sec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "setup": {
          "$ref": "#/$defs/verificationSetup"
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/verificationCommand"
          }
        }
      }
    },
    "verificationSetup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands"
      ],
      "properties": {
        "timeout_sec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/verificationCommand"
          }
        }
      }
    },
    "verificationCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string",
          "pattern": "^[^\\\\/\\s]+$"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "description": "Keys removed in 3.0 (planning, goal_refs, goal_policy, goal_exemption, classification, parent_run_id, feed, delivery.release_required, delivery.release_mode, delivery.review_budget) are ignored with a warning."
}
