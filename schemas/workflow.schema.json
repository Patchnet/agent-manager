{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Patchnet/agent-manager/schemas/workflow.schema.json",
  "title": "agent-manager workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["repo", "planning", "lanes"],
  "properties": {
    "repo": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "repo_shorthand": { "type": "string", "minLength": 1, "maxLength": 64 },
    "harness_default": { "enum": ["claude", "codex", "fake"] },
    "model_default": { "type": "string", "minLength": 1 },
    "integrate": { "type": "boolean" },
    "claim_mode": { "enum": ["auto", "off", "required"] },
    "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 5 },
    "remote": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
    "base_ref": { "type": "string", "minLength": 1 },
    "env_allowlist": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" } },
    "policy": { "$ref": "#/$defs/policy" },
    "feed": { "$ref": "#/$defs/feed" },
    "verification": { "$ref": "#/$defs/verification" },
    "planning": { "$ref": "#/$defs/planning" },
    "delivery": { "$ref": "#/$defs/delivery" },
    "scope_overrides": {
      "type": "array",
      "items": { "$ref": "#/$defs/scopeOverride" }
    },
    "lanes": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/lane" } }
  },
  "$defs": {
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["single", "train", "review-only"] },
        "release_required": { "type": "boolean" },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/deliveryTarget" }
        }
      }
    },
    "deliveryTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lane"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
        "lane": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
        "branch": { "type": "string", "minLength": 1 },
        "base": { "type": "string", "minLength": 1 },
        "pr": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "integer", "minimum": 1 }] }
      }
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_refs",
        "plan_ref",
        "reviewed_base_sha",
        "verified_by",
        "verified_at",
        "reviewed_paths",
        "repository_instruction_refs",
        "attestations"
      ],
      "oneOf": [{ "required": ["context"] }, { "required": ["context_file"] }],
      "properties": {
        "source_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "plan_ref": { "type": "string", "minLength": 1 },
        "context": { "type": "string", "minLength": 1, "maxLength": 131072 },
        "context_file": { "type": "string", "minLength": 1 },
        "reviewed_base_sha": { "type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
        "verified_by": { "type": "string", "minLength": 1 },
        "verified_at": { "type": "string", "format": "date-time" },
        "reviewed_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "repository_instruction_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "attestations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_reviewed", "repository_instructions_reviewed", "relevant_code_reviewed", "scope_verified"],
          "properties": {
            "source_reviewed": { "type": "boolean" },
            "repository_instructions_reviewed": { "type": "boolean" },
            "relevant_code_reviewed": { "type": "boolean" },
            "scope_verified": { "type": "boolean" }
          }
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope"],
      "anyOf": [{ "required": ["prompt"] }, { "required": ["prompt_file"] }],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
        "harness": { "enum": ["claude", "codex", "fake"] },
        "model": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["implementation", "review"] },
        "scope": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }] },
        "expected_outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "allow_no_changes": { "type": "boolean" },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" }
        },
        "prompt": { "type": "string", "minLength": 1 },
        "prompt_file": { "type": "string", "minLength": 1 },
        "fake": { "type": "object" }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "allow_commit": { "type": "boolean" }, "allow_pr": { "type": "boolean" },
        "dangerously_skip_permissions": { "type": "boolean" },
        "permission_mode": { "enum": ["acceptEdits", "readOnly", "read-only", "read_only", "workspace-write"] },
        "stall_timeout_sec": { "type": "number", "minimum": 5, "maximum": 86400 },
        "poll_interval_ms": { "type": "number", "minimum": 100, "maximum": 60000 }
      }
    },
    "feed": {
      "type": "object", "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" }, "baseUrl": { "type": "string", "format": "uri" }, "topic": { "type": "string", "minLength": 1 } }
    },
    "scopeOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "lanes", "owner", "reason"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "lanes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" }
        },
        "owner": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
        "reason": { "type": "string", "minLength": 1 },
        "access": {
          "type": "object",
          "additionalProperties": { "enum": ["write", "read-only"] }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "properties": {
        "timeout_sec": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command"],
            "properties": {
              "command": { "type": "string", "pattern": "^[^\\\\/\\s]+$" },
              "args": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
