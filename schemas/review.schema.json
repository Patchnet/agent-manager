{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Patchnet/agent-manager/schemas/review.schema.json",
  "title": "agent-manager Delivery Review",
  "type": "object",
  "required": ["schema", "runId", "pass", "path", "markdown"],
  "properties": {
    "schema": { "const": "agent-manager.review.v1" }, "runId": { "type": "string" },
    "pass": { "enum": [1, 2] },
    "verdict": { "enum": ["accept", "accept-with-notes", "revise", "relaunch", "reject", null] },
    "state": { "enum": ["delivery_review_pending", "correction_pending", "ship_gate_pending", "reviewed", "rejected"] },
    "decisionPath": { "type": ["string", "null"] },
    "path": { "type": "string" }, "markdown": { "type": "string" }
  }
}
