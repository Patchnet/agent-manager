{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Patchnet/agent-manager/schemas/launch.schema.json",
  "title": "agent-manager detached launch",
  "type": "object",
  "required": ["runId", "state", "pid", "telemetry", "supervisorLog", "statusCommand"],
  "properties": {
    "runId": { "type": "string" }, "state": { "const": "detached" }, "pid": { "type": "integer" },
    "identity": { "$ref": "status.schema.json#/$defs/runIdentity" },
    "suggestedThreadTitle": { "type": "string", "minLength": 1, "maxLength": 80 },
    "telemetry": { "type": "string" }, "supervisorLog": { "type": "string" }, "statusCommand": { "type": "string" },
    "runtime": { "$ref": "status.schema.json#/$defs/runtime" },
    "masterReturn": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "pid", "log", "channel"],
          "properties": {
            "state": { "enum": ["watching", "failed"] },
            "pid": { "type": ["integer", "null"] },
            "log": { "type": "string" },
            "channel": { "$ref": "status.schema.json#/$defs/masterReturnSummary" }
          }
        }
      ]
    }
  }
}
