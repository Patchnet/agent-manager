{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Patchnet/agent-manager/schemas/director-source-item.schema.json",
  "title": "Agent Manager Director normalized source item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "source", "repository", "objective", "acceptance_criteria",
    "priority", "dependencies", "automation_eligible", "labels", "risks",
    "scope", "planning"
  ],
  "properties": {
    "schema": { "const": "agent-manager.director-source-item.v1" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "item_id", "ref"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "item_id": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "base_ref", "reviewed_base_sha"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "base_ref": { "type": "string", "minLength": 1 },
        "reviewed_base_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }
      }
    },
    "objective": { "type": "string", "minLength": 1 },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
    "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "automation_eligible": { "type": "boolean" },
    "labels": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "risks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "goal_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^goal-[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
        "maxLength": 128
      }
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_ref", "verified_by", "verified_at", "repository_instruction_refs", "reviewed_paths"],
      "properties": {
        "plan_ref": { "type": "string", "minLength": 1 },
        "verified_by": { "type": "string", "minLength": 1 },
        "verified_at": { "type": "string", "format": "date-time" },
        "repository_instruction_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "reviewed_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
