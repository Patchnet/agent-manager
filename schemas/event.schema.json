{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Patchnet/agent-manager/schemas/event.schema.json",
  "title": "agent-manager event",
  "description": "One line of events.jsonl. Fields are only added within a version; see docs/EVENTS.md.",
  "type": "object",
  "required": ["v", "ts", "kind", "repo", "actor"],
  "properties": {
    "v": { "const": 1 },
    "ts": { "type": "string", "format": "date-time" },
    "kind": {
      "enum": ["lane_started", "lane_done", "review_verdict", "pr_opened", "automerge_armed", "merged",
        "reverted", "waiting_operator", "operator_reply", "blocked", "cancelled", "run_closed"]
    },
    "repo": { "type": "string", "minLength": 1 },
    "runId": { "type": "string" },
    "lane": { "type": "string" },
    "pr": { "type": "integer" },
    "sha": { "type": "string" },
    "tier": { "enum": [0, 1, 2] },
    "verdict": { "type": "string" },
    "text": { "type": "string" },
    "actor": { "type": "string", "minLength": 1 }
  }
}
