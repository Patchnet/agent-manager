{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Patchnet/agent-manager/schemas/event.schema.json",
  "title": "agent-manager event",
  "type": "object",
  "required": ["schema", "type", "at", "runId", "state", "lanes", "cadence"],
  "properties": {
    "schema": { "const": "agent-manager.event.v1" }, "type": { "const": "status" },
    "at": { "type": "string", "format": "date-time" }, "runId": { "type": "string" },
    "state": { "enum": ["running", "workers_done", "delivery_review_pending", "correction_pending", "ship_gate_pending", "shipping", "blocked", "release_pending", "reviewed", "merged", "released", "rejected", "failed", "cancelled"] },
    "runtime": { "anyOf": [{ "$ref": "status.schema.json#/$defs/runtime" }, { "type": "null" }] },
    "lanes": { "type": "array", "items": { "$ref": "status.schema.json#/$defs/laneStatus" } },
    "ship": { "type": ["object", "null"] },
    "delivery": { "type": ["object", "null"] },
    "awareness": { "type": ["object", "null"] },
    "cadence": { "$ref": "operator-cadence.schema.json" }
  }
}
