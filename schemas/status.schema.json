{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Patchnet/agent-manager/schemas/status.schema.json",
  "title": "agent-manager status",
  "type": "object",
  "required": ["runId", "state", "repo", "startedAt", "lanes"],
  "properties": {
    "runId": { "type": "string" }, "state": { "enum": ["running", "workers_done", "delivery_review_pending", "correction_pending", "ship_gate_pending", "shipping", "blocked", "release_pending", "reviewed", "filed", "merged", "released", "rejected", "failed", "cancelled"] },
    "agentManager": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": { "version": { "type": "string" } }
    },
    "identity": { "$ref": "#/$defs/runIdentity" },
    "repo": { "type": "string" }, "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": ["string", "null"] },
    "lanes": { "type": "array", "items": { "$ref": "#/$defs/laneStatus" } },
    "topology": { "type": "object" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "masterReturn": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/masterReturnSummary" }
      ]
    },
    "planning": {
      "type": "object",
      "required": ["state", "sourceRefs", "planRef", "contextFile", "contextDigest", "reviewedBaseSha", "actualBaseSha", "verifiedBy", "verifiedAt", "reviewedPaths", "repositoryInstructionRefs", "attestations"],
      "properties": {
        "state": { "const": "verified" },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "planRef": { "type": "string" },
        "contextFile": { "type": "string" },
        "contextDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "contextSnapshot": { "type": "string" },
        "reviewedBaseSha": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
        "actualBaseSha": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
        "verifiedBy": { "type": "string" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "reviewedPaths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "repositoryInstructionRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "attestations": { "type": "object" }
      }
    },
    "goalRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^goal-[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$" }
    },
    "goals": {
      "type": "object",
      "required": ["schema", "refs", "goals", "artifactLinks", "contextDigest", "contextSnapshot"],
      "properties": {
        "schema": { "const": "agent-manager.run-goals.v1" },
        "refs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "goals": { "type": "array", "items": { "type": "object" } },
        "artifactLinks": { "type": "array", "items": { "type": "object" } },
        "contextDigest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "contextSnapshot": { "type": ["string", "null"] }
      }
    },
    "awareness": { "$ref": "#/$defs/awareness" },
    "authorization": { "$ref": "#/$defs/authorizationSummary" },
    "delivery": {
      "type": "object",
      "required": ["schema", "mode", "state", "review", "targets", "release"],
      "properties": {
        "schema": { "const": "agent-manager.delivery.v1" },
        "mode": { "enum": ["single", "train", "review-only"] },
        "state": { "enum": ["workers_running", "review_pending", "correction_pending", "ship_gate_pending", "shipping", "blocked", "targets_pending", "release_pending", "reviewed", "merged", "released", "rejected", "failed", "cancelled"] },
        "releaseRequired": { "type": "boolean" },
        "workersCompletedAt": { "type": ["string", "null"] },
        "review": { "type": "object" },
        "targets": { "type": "array" },
        "release": { "type": "object" }
      }
    },
    "ship": {
      "type": "object",
      "required": ["schema", "state", "phase", "approve", "branch", "base", "remote"],
      "properties": {
        "schema": { "const": "agent-manager.ship.v1" },
        "state": { "enum": ["queued", "running", "blocked", "done", "failed", "cancelled"] },
        "phase": { "enum": ["preflight", "commit", "push", "pr", "merge", "release", "release-push", "ci", "tag", "done"] },
        "approve": { "enum": ["through-pr", "all"] },
        "runtime": { "$ref": "#/$defs/runtime" },
        "branch": { "type": "string" },
        "base": { "type": "string" },
        "remote": { "type": "string" },
        "prUrl": { "type": ["string", "null"] },
        "targetId": { "type": ["string", "null"] },
        "mergeSha": { "type": ["string", "null"] },
        "releaseSha": { "type": ["string", "null"] },
        "plannedTag": { "type": ["string", "null"] },
        "tag": { "type": ["string", "null"] },
        "lastActivity": { "type": ["string", "null"] },
        "checks": { "type": "array" },
        "ci": { "type": ["object", "null"] },
        "releaseWorktree": { "type": ["string", "null"] },
        "needsInput": { "type": ["object", "null"] },
        "steps": { "type": "array" },
        "authorization": {
          "type": ["object", "null"],
          "properties": {
            "grantDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "receiptDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    }
  },
  "$defs": {
    "authorizationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "state", "valid", "level", "grantDigest", "evidenceDigest", "manifestDigest", "riskCeiling", "providerMode", "expiresAt", "permittedMutations", "failureCode", "nextAction", "receiptDigest"],
      "properties": {
        "schema": { "const": "agent-manager.authorization-summary.v1" },
        "state": { "enum": ["ready", "blocked", "revoked", "expired", "consumed"] },
        "valid": { "type": "boolean" },
        "level": { "enum": ["through-pr", "all"] },
        "grantDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "evidenceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "manifestDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "riskCeiling": { "enum": ["low", "moderate", "high", "critical"] },
        "providerMode": { "type": "string" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "permittedMutations": { "type": "array", "items": { "type": "string" } },
        "failureCode": { "type": ["string", "null"] },
        "nextAction": { "type": ["string", "null"] },
        "receiptDigest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "awareness": {
      "type": "object",
      "required": ["schema", "state"],
      "properties": {
        "schema": { "const": "agent-manager.awareness.v1" },
        "state": { "enum": ["pending", "admitted", "running", "needs_input", "pending_delivery", "shipping", "reviewed", "merged", "released", "rejected", "failed", "cancelled", "abandoned", "blocked"] },
        "phase": { "enum": ["editing", "delivery", "terminal"] },
        "historyMode": { "const": "feed" },
        "brainRoot": { "type": "string" },
        "intentId": { "type": "string" },
        "runId": { "type": "string" },
        "repoKey": { "type": "string" },
        "repoLabel": { "type": "string" },
        "repoIdentitySource": { "enum": ["remote", "path"] },
        "scopes": { "type": "array", "items": { "type": "string" } },
        "activeRelated": { "type": "array" },
        "deliveryDependencies": { "type": "array" },
        "admittedAt": { "type": "string", "format": "date-time" },
        "heartbeatAt": { "type": "string", "format": "date-time" },
        "leaseExpiresAt": { "type": "string", "format": "date-time" },
        "context": { "type": "string" },
        "contextDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "contextSnapshot": { "type": "string" },
        "code": { "type": "string" },
        "conflicts": { "type": "array" },
        "lastError": { "type": "string" }
      }
    },
    "runIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "displayTitle", "suggestedThreadTitle", "repoShorthand", "subject", "manager"],
      "properties": {
        "schema": { "const": "agent-manager.run-identity.v1" },
        "displayTitle": { "type": "string", "minLength": 1, "maxLength": 80 },
        "suggestedThreadTitle": { "type": "string", "minLength": 1, "maxLength": 80 },
        "repoShorthand": { "type": "string", "minLength": 1, "maxLength": 64 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 160 },
        "manager": {
          "type": "object",
          "additionalProperties": false,
          "required": ["harness", "model", "modelSource", "threadTitle"],
          "properties": {
            "harness": { "type": ["string", "null"] },
            "model": { "type": ["string", "null"] },
            "modelSource": { "enum": ["cli", "environment", "declared", "unavailable"] },
            "threadTitle": { "type": ["string", "null"] }
          }
        }
      }
    },
    "laneStatus": {
      "type": "object",
      "required": ["id", "harness", "state"],
      "properties": {
        "id": { "type": "string" },
        "harness": { "type": "string" },
        "modelRequested": { "type": ["string", "null"] },
        "modelObserved": { "type": ["string", "null"] },
        "permissionMode": { "type": "string" },
        "allowedTools": { "type": "array", "items": { "type": "string" } },
        "setup": { "type": "object" },
        "state": { "type": "string" }
      }
    },
    "masterReturnSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "mode", "configured", "state", "attempts", "lastAttemptAt", "lastDeliveredAt", "lastSignaledAt", "lastError"],
      "properties": {
        "host": { "enum": ["codex", "claude", "cursor"] },
        "mode": { "enum": ["direct", "signal"] },
        "configured": { "const": true },
        "state": { "enum": ["configured", "watching", "delivering", "delivered", "signal_ready", "failed"] },
        "attempts": { "type": "integer", "minimum": 0 },
        "lastAttemptAt": { "type": ["string", "null"] },
        "lastDeliveredAt": { "type": ["string", "null"] },
        "lastSignaledAt": { "type": ["string", "null"] },
        "lastError": { "type": ["string", "null"] }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostPlatform", "os", "arch", "release", "shell", "commandMode", "pathStyle"],
      "properties": {
        "hostPlatform": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "release": { "type": "string" },
        "shell": { "type": "string", "minLength": 1 },
        "commandMode": { "const": "spawn-no-shell" },
        "pathStyle": { "enum": ["windows", "posix"] }
      }
    }
  }
}
