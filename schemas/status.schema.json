{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Patchnet/agent-manager/schemas/status.schema.json",
  "title": "agent-manager status",
  "description": "Run state at <runsRoot>/<runId>/status.json. Additional fields may appear; consumers ignore what they do not use.",
  "type": "object",
  "required": ["runId", "state", "repo", "lanes"],
  "properties": {
    "runId": { "type": "string" },
    "state": {
      "enum": ["running", "blocked", "workers_done", "review_pending", "correction_pending", "ship_pending",
        "shipping", "waiting_operator", "merged", "reviewed", "closed", "rejected", "failed", "cancelled"]
    },
    "repo": { "type": "string" },
    "repoRoot": { "type": "string" },
    "goal": { "type": ["string", "null"] },
    "target_dev_flow": { "type": "string" },
    "baseRef": { "type": "string" },
    "baseCommit": { "type": "string" },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": ["string", "null"] },
    "updatedAt": { "type": "string", "format": "date-time" },
    "error": { "type": "string" },
    "agentManager": { "type": "object", "properties": { "version": { "type": "string" } } },
    "identity": {
      "type": "object",
      "properties": {
        "displayTitle": { "type": "string" },
        "subject": { "type": "string" },
        "repoShorthand": { "type": "string" },
        "manager": { "type": "object" }
      }
    },
    "runtime": { "type": "object" },
    "lanes": { "type": "array", "items": { "$ref": "#/$defs/lane" } },
    "integrate": {
      "type": "object",
      "properties": {
        "state": { "enum": ["running", "ready", "blocked", "failed"] },
        "branch": { "type": "string" },
        "worktree": { "type": "string" },
        "error": { "type": "string" }
      }
    },
    "delivery": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["single", "train", "review-only"] },
        "review": {
          "type": "object",
          "properties": {
            "verdict": { "enum": ["accept", "revise", "reject", null] },
            "reviewer": { "type": ["string", "null"] },
            "notes": { "type": ["string", "null"] },
            "decidedAt": { "type": ["string", "null"] },
            "history": { "type": "array" }
          }
        },
        "targets": { "type": "array", "items": { "$ref": "#/$defs/target" } }
      }
    }
  },
  "$defs": {
    "lane": {
      "type": "object",
      "required": ["id", "state", "harness"],
      "properties": {
        "id": { "type": "string" },
        "state": { "enum": ["queued", "dependency-waiting", "running", "blocked", "done", "failed", "cancelled"] },
        "harness": { "type": "string" },
        "modelRequested": { "type": ["string", "null"] },
        "modelObserved": { "type": ["string", "null"] },
        "branch": { "type": "string" },
        "worktree": { "type": ["string", "null"] },
        "scope": { "type": "string" },
        "dependsOn": { "type": "array", "items": { "type": "string" } },
        "sessionId": { "type": ["string", "null"] },
        "attempt": { "type": "integer" },
        "exitCode": { "type": ["integer", "null"] },
        "lastActivity": { "type": "string" },
        "changedFiles": { "type": "array", "items": { "type": "string" } },
        "needsInput": { "type": ["object", "null"] },
        "scopeViolations": { "type": "array" },
        "readOnlyViolations": { "type": "array" },
        "policyViolations": { "type": "array" },
        "ratification": { "type": ["object", "null"] },
        "claim": { "type": "object" }
      }
    },
    "target": {
      "type": "object",
      "required": ["id", "state"],
      "properties": {
        "id": { "type": "string" },
        "laneId": { "type": "string" },
        "branch": { "type": "string" },
        "base": { "type": ["string", "null"] },
        "worktree": { "type": ["string", "null"] },
        "changedFiles": { "type": "array", "items": { "type": "string" } },
        "state": { "enum": ["pending", "changes_ready", "no_changes", "pr_open", "merged", "closed"] },
        "tier": { "enum": [0, 1, 2, null] },
        "tierFiles": { "type": "array", "items": { "type": "string" } },
        "pr": { "type": ["string", "null"] },
        "prUrl": { "type": ["string", "null"] },
        "autoMerge": { "type": "boolean" },
        "approvedBy": { "type": "string" },
        "waitingOperator": { "type": ["string", "null"] },
        "mergeSha": { "type": ["string", "null"] },
        "mergedAt": { "type": ["string", "null"] }
      }
    }
  }
}
