{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goal criterion evidence for Delivery Review",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["goalId", "goalDigest", "criteria"],
    "properties": {
      "goalId": { "type": "string", "pattern": "^goal-" },
      "goalDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "outcome": { "enum": ["fulfilled", "partial"] },
      "criteria": {
        "type": "array", "minItems": 1,
        "items": {
          "type": "object", "required": ["criterion", "state", "evidence"],
          "properties": {
            "criterion": { "type": "string", "minLength": 1 },
            "state": { "enum": ["met", "unmet", "not-addressed"] },
            "evidence": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
