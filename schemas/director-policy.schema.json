{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Patchnet/agent-manager/schemas/director-policy.schema.json",
  "title": "Agent Manager Director standing policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repository", "director", "autopilot"],
  "properties": {
    "schema": { "const": "agent-manager.director-policy.v1" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "base_ref": { "type": "string", "minLength": 1, "default": "HEAD" }
      }
    },
    "director": { "$ref": "#/$defs/agentIdentity" },
    "automation_policy": {
      "type": "object",
      "required": ["schema", "enabled", "repository", "approval", "risk", "provider", "shipment"],
      "properties": {
        "schema": { "const": "agent-manager.automation-policy.v1" },
        "enabled": { "const": true },
        "approval": { "type": "object", "required": ["level"], "properties": { "level": { "const": "through-pr" } } }
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "harness_default": { "enum": ["claude", "codex", "cursor", "fake"] },
        "model_default": { "type": "string", "minLength": 1 },
        "harness_options": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "effort": { "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max"] },
            "profile": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$" }
          }
        }
      }
    },
    "autopilot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled", "mode", "source_filter", "allowed_actions", "allowed_paths",
        "forbidden_risks", "max_items_per_cycle", "max_concurrency",
        "correction_limit", "on_blocker"
      ],
      "properties": {
        "enabled": { "const": true },
        "mode": { "enum": ["pr-only", "auto-merge"] },
        "source_filter": { "type": "string", "minLength": 1 },
        "allowed_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["plan", "run", "review", "commit", "push", "open-pr", "ship", "merge"] }
        },
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbidden_risks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "risk_exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["risk", "require_labels", "allowed_paths"],
            "properties": {
              "risk": { "type": "string", "minLength": 1 },
              "require_labels": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "allowed_paths": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "max_items_per_cycle": { "type": "integer", "minimum": 1, "maximum": 20 },
        "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 5 },
        "correction_limit": { "type": "integer", "minimum": 0, "maximum": 1 },
        "on_blocker": { "const": "quarantine-and-continue" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "autopilot": { "properties": { "mode": { "const": "pr-only" } } } } },
      "then": {
        "not": { "required": ["automation_policy"] },
        "properties": { "autopilot": { "properties": { "allowed_actions": { "not": { "contains": { "const": "merge" } } } } } }
      },
      "else": {
        "required": ["automation_policy"],
        "properties": { "autopilot": { "properties": { "allowed_actions": { "allOf": [{ "contains": { "const": "merge" } }, { "contains": { "const": "ship" } }] } } } }
      }
    }
  ],
  "$defs": {
    "agentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness", "model", "reasoning"],
      "properties": {
        "harness": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "reasoning": { "enum": ["low", "medium", "high", "xhigh"] }
      }
    }
  }
}
